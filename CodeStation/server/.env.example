# CodeStation server
PORT=3000
NODE_ENV=development

# Existing compiler service
COMPILER_API_KEY=your_compiler_api_key
COMPILER_API_BASE=https://api.onlinecompiler.io

# Bob AI service: Groq (recommended default; create a key at console.groq.com)
BOB_API_KEY=your_groq_api_key
BOB_API_BASE_URL=https://api.groq.com/openai/v1
BOB_MODEL=openai/gpt-oss-20b

# Room snapshots (private S3 bucket; EC2 should use an instance role)
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=
S3_ROOM_PREFIX=rooms

# To use NVIDIA NIM instead, comment out the Groq values above and use:
# BOB_API_KEY=your_nvidia_api_key
# BOB_API_BASE_URL=https://integrate.api.nvidia.com/v1
# BOB_MODEL=openai/gpt-oss-20b
